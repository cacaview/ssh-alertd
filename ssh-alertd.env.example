# Credentials for ssh-alertd, read at startup. Every SSH_ALERTD_* variable
# here overrides the matching value in config.json; a variable already set in
# the process environment wins over this file.
#
# Copy the template, fill in real values, restrict permissions, and keep it
# out of version control:
#   sudo install -m0600 ssh-alertd.env.example /etc/ssh-alertd/ssh-alertd.env
#
# systemd reads this file as EnvironmentFile= in deploy/ssh-alertd.service.
# When you start the daemon by hand, point it at the file with
#   ssh-alertd -config ... -env-file /etc/ssh-alertd/ssh-alertd.env
#
# Values are never expanded or executed: quotes are optional and there is no
# shell syntax.

# --- Notifiers ---
# Enabled in JSON; the secrets come from here.
#SSH_ALERTD_TELEGRAM_ENABLED=true
SSH_ALERTD_TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe
SSH_ALERTD_TELEGRAM_CHAT_ID=-1001234567890
#
#SSH_ALERTD_SMTP_ENABLED=true
#SSH_ALERTD_SMTP_HOST=smtp.example.com
#SSH_ALERTD_SMTP_PORT=587
#SSH_ALERTD_SMTP_USERNAME=alert@example.com
#SSH_ALERTD_SMTP_PASSWORD=your-smtp-password
#SSH_ALERTD_SMTP_FROM=alert@example.com
# Recipients: separate with ";" or spaces, not commas.
#SSH_ALERTD_SMTP_TO=admin@example.com
#
# --- Optional settings (uncomment to override config.json) ---
#SSH_ALERTD_HOSTNAME=web-01
#SSH_ALERTD_LOG_SOURCE_TYPE=journald
#SSH_ALERTD_LOG_SOURCE_PATH=/var/log/auth.log
#SSH_ALERTD_TELEGRAM_API_BASE=https://api.telegram.org
#SSH_ALERTD_TELEGRAM_PARSE_MODE=HTML
#SSH_ALERTD_SMTP_ENCRYPTION=starttls
#SSH_ALERTD_SMTP_HTML=false
